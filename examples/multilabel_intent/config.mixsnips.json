{
  "train_file": "examples/multilabel_intent/data/mixsnips/train.jsonl",
  "dev_file": "examples/multilabel_intent/data/mixsnips/dev.jsonl",
  "test_file": "examples/multilabel_intent/data/mixsnips/test.jsonl",
  "labels_file": "examples/multilabel_intent/data/mixsnips/labels.json",
  "output_dir": "examples/multilabel_intent/runs/mixsnips_laya",

  "init": "convaiinnovations/laya",

  "epochs": 2,
  "micro_batch": 8,
  "grad_accum": 4,
